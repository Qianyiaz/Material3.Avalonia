<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pr="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
                    xmlns:attached="clr-namespace:Material3.Avalonia.Attached;assembly=Material3.Avalonia">
    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <Border IsHitTestVisible="False"
                        AdornerLayer.IsClipEnabled="False"
                        BorderThickness="{Binding Path=(pr:AdornerLayer.AdornedElement).(attached:FocusRing.Thickness),
                                                         RelativeSource={RelativeSource Self}}"
                        Margin="{Binding Path=(pr:AdornerLayer.AdornedElement).(attached:FocusRing.EffectiveMargin),
                                                         RelativeSource={RelativeSource Self}}"
                        CornerRadius="{Binding Path=(pr:AdornerLayer.AdornedElement).(attached:FocusRing.EffectiveCornerRadius),
                                                         RelativeSource={RelativeSource Self}}"
                        BorderBrush="{Binding Path=(pr:AdornerLayer.AdornedElement).(attached:FocusRing.Brush),
                                                         RelativeSource={RelativeSource Self}}" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>