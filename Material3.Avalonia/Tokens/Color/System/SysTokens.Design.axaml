<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================
       Primary / Secondary / Tertiary
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorPrimaryBrush" Color="{DynamicResource MdRefPrimary40Color}" />
    <SolidColorBrush x:Key="MdSysColorOnPrimaryBrush" Color="{DynamicResource MdRefPrimary100Color}" />
    <SolidColorBrush x:Key="MdSysColorPrimaryContainerBrush" Color="{DynamicResource MdRefPrimary90Color}" />
    <SolidColorBrush x:Key="MdSysColorOnPrimaryContainerBrush" Color="{DynamicResource MdRefPrimary30Color}" />

    <SolidColorBrush x:Key="MdSysColorSecondaryBrush" Color="{DynamicResource MdRefSecondary40Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSecondaryBrush" Color="{DynamicResource MdRefSecondary100Color}" />
    <SolidColorBrush x:Key="MdSysColorSecondaryContainerBrush" Color="{DynamicResource MdRefSecondary90Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSecondaryContainerBrush" Color="{DynamicResource MdRefSecondary30Color}" />

    <SolidColorBrush x:Key="MdSysColorTertiaryBrush" Color="{DynamicResource MdRefTertiary40Color}" />
    <SolidColorBrush x:Key="MdSysColorOnTertiaryBrush" Color="{DynamicResource MdRefTertiary100Color}" />
    <SolidColorBrush x:Key="MdSysColorTertiaryContainerBrush" Color="{DynamicResource MdRefTertiary90Color}" />
    <SolidColorBrush x:Key="MdSysColorOnTertiaryContainerBrush" Color="{DynamicResource MdRefTertiary30Color}" />

    <!-- =========================
       Error
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorErrorBrush" Color="{DynamicResource MdRefError40Color}" />
    <SolidColorBrush x:Key="MdSysColorOnErrorBrush" Color="{DynamicResource MdRefError100Color}" />
    <SolidColorBrush x:Key="MdSysColorErrorContainerBrush" Color="{DynamicResource MdRefError90Color}" />
    <SolidColorBrush x:Key="MdSysColorOnErrorContainerBrush" Color="{DynamicResource MdRefError30Color}" />

    <!-- =========================
       Surface family (Neutral / NeutralVariant)
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorSurfaceBrush" Color="{DynamicResource MdRefNeutral98Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSurfaceBrush" Color="{DynamicResource MdRefNeutral10Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceVariantBrush" Color="{DynamicResource MdRefNeutralVariant90Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSurfaceVariantBrush" Color="{DynamicResource MdRefNeutralVariant30Color}" />

    <!-- =========================
       Surface containers (Neutral)
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorSurfaceContainerLowestBrush" Color="{DynamicResource MdRefNeutral100Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceContainerLowBrush" Color="{DynamicResource MdRefNeutral96Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceContainerBrush" Color="{DynamicResource MdRefNeutral94Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceContainerHighBrush" Color="{DynamicResource MdRefNeutral92Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceContainerHighestBrush" Color="{DynamicResource MdRefNeutral90Color}" />

    <!-- =========================
       Outline / OutlineVariant (NeutralVariant)
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorOutlineBrush" Color="{DynamicResource MdRefNeutralVariant50Color}" />
    <SolidColorBrush x:Key="MdSysColorOutlineVariantBrush" Color="{DynamicResource MdRefNeutralVariant80Color}" />

    <!-- =========================
       Inverse
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorInverseSurfaceBrush" Color="{DynamicResource MdRefNeutral20Color}" />
    <SolidColorBrush x:Key="MdSysColorInverseOnSurfaceBrush" Color="{DynamicResource MdRefNeutral95Color}" />
    <SolidColorBrush x:Key="MdSysColorInversePrimaryBrush" Color="{DynamicResource MdRefPrimary80Color}" />

    <!-- =========================
       Add-ons
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorSurfaceDimBrush" Color="{DynamicResource MdRefNeutral87Color}" />
    <SolidColorBrush x:Key="MdSysColorSurfaceBrightBrush" Color="{DynamicResource MdRefNeutral98Color}" />

    <!-- =========================
       Scrim / Shadow
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorScrimBrush" Color="{DynamicResource MdRefNeutral00Color}" />
    <SolidColorBrush x:Key="MdSysColorShadowBrush" Color="{DynamicResource MdRefNeutral00Color}" />

    <!-- =========================
       Fixed palettes
       ========================= -->
    <SolidColorBrush x:Key="MdSysColorPrimaryFixedBrush" Color="{DynamicResource MdRefPrimary90Color}" />
    <SolidColorBrush x:Key="MdSysColorPrimaryFixedDimBrush" Color="{DynamicResource MdRefPrimary80Color}" />
    <SolidColorBrush x:Key="MdSysColorOnPrimaryFixedBrush" Color="{DynamicResource MdRefPrimary10Color}" />
    <SolidColorBrush x:Key="MdSysColorOnPrimaryFixedVariantBrush" Color="{DynamicResource MdRefPrimary30Color}" />

    <SolidColorBrush x:Key="MdSysColorSecondaryFixedBrush" Color="{DynamicResource MdRefSecondary90Color}" />
    <SolidColorBrush x:Key="MdSysColorSecondaryFixedDimBrush" Color="{DynamicResource MdRefSecondary80Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSecondaryFixedBrush" Color="{DynamicResource MdRefSecondary10Color}" />
    <SolidColorBrush x:Key="MdSysColorOnSecondaryFixedVariantBrush" Color="{DynamicResource MdRefSecondary30Color}" />

    <SolidColorBrush x:Key="MdSysColorTertiaryFixedBrush" Color="{DynamicResource MdRefTertiary90Color}" />
    <SolidColorBrush x:Key="MdSysColorTertiaryFixedDimBrush" Color="{DynamicResource MdRefTertiary80Color}" />
    <SolidColorBrush x:Key="MdSysColorOnTertiaryFixedBrush" Color="{DynamicResource MdRefTertiary10Color}" />
    <SolidColorBrush x:Key="MdSysColorOnTertiaryFixedVariantBrush" Color="{DynamicResource MdRefTertiary30Color}" />

</ResourceDictionary>