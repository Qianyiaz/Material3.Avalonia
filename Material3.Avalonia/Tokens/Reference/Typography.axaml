<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="MdRefTypefaceBrand">avares://Material3.Avalonia/Assets/Fonts/Roboto#Roboto</FontFamily>
    <FontFamily x:Key="MdRefTypefacePlain">avares://Material3.Avalonia/Assets/Fonts/Roboto#Roboto</FontFamily>
    
    <FontFamily x:Key="MdRefTypefaceEmphasizedBrand">avares://Material3.Avalonia/Assets/Fonts/Roboto#Roboto</FontFamily>
    <FontFamily x:Key="MdRefTypefaceEmphasizedPlain">avares://Material3.Avalonia/Assets/Fonts/Roboto#Roboto</FontFamily>

    
    <FontWeight x:Key="MdRefTypefaceWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="MdRefTypefaceWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="MdRefTypefaceWeightBold">Bold</FontWeight>
</ResourceDictionary>
