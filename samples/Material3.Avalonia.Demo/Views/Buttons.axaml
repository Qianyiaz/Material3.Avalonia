<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Material3.Avalonia.Attached.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="460"
             x:Class="Material3.Avalonia.Demo.Views.Buttons" ClipToBounds="False">
    <StackPanel Spacing="16" Orientation="Vertical">
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Extra small" Classes="tonal xs" />
            <Button Content="Small" Classes="tonal sm" />
            <Button Content="Medium" Classes="tonal md" />
            <Button Content="Large" Classes="tonal lg" />
            <Button Content="Extra large" Classes="tonal xl" />
        </StackPanel>
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Elevated" Classes="elevated md" />
            <Button Content="Filled" Classes="filled md" />
            <Button Content="Tonal" Classes="tonal md" />
            <Button Content="Outlined" Classes="outlined md" />
            <Button Content="Text" Classes="text md" />
        </StackPanel>
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Elevated" Classes="elevated md" IsEnabled="False" />
            <Button Content="Filled" Classes="filled md" IsEnabled="False" />
            <Button Content="Tonal" Classes="tonal md" IsEnabled="False" />
            <Button Content="Outlined" Classes="outlined md" IsEnabled="False" />
            <Button Content="Text" Classes="text md" IsEnabled="False" />
        </StackPanel>
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Elevated" Classes="elevated md square" />
            <Button Content="Filled" Classes="filled md square" />
            <Button Content="Tonal" Classes="tonal md square" />
            <Button Content="Outlined" Classes="outlined md square" />
            <Button Content="Text" Classes="text md square" />
        </StackPanel>
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Elevated" Classes="elevated md" controls:ButtonAssist.Icon="{StaticResource PencilIcon}" />
            <Button Content="Filled" Classes="filled md" controls:ButtonAssist.Icon="{StaticResource PencilIcon}" />
            <Button Content="Tonal" Classes="tonal md" controls:ButtonAssist.Icon="{StaticResource PencilIcon}" />
            <Button Content="Outlined" Classes="outlined md" controls:ButtonAssist.Icon="{StaticResource PencilIcon}" />
            <Button Content="Text" Classes="text md" controls:ButtonAssist.Icon="{StaticResource PencilIcon}" />
        </StackPanel>
        <StackPanel Spacing="16" Orientation="Horizontal">
            <Button Content="Elevated" Classes="elevated md"
                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
            <Button Content="Filled" Classes="filled md"
                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
            <Button Content="Tonal" Classes="tonal md"
                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
            <Button Content="Outlined" Classes="outlined md"
                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
            <Button Content="Text" Classes="text md"
                    controls:ButtonAssist.Icon="avares://Material3.Avalonia.Demo/Assets/avatar_24.png" />
        </StackPanel>
    </StackPanel>
</UserControl>