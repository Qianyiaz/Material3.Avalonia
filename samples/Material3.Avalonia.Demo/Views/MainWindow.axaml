<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Material3.Avalonia.Demo.Views"
        xmlns:controls="using:Material3.Avalonia.Controls"
        x:Class="Material3.Avalonia.Demo.Views.MainWindow"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Background="{DynamicResource MdSysBackgroundBrush}"
        Title="MainWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <views:TonalPalettes />

            <views:SchemeColors />

            <views:Buttons />

            <Border BorderBrush="Black" BorderThickness="1" Padding="4" Margin="100"
                    Width="{Binding $self.Bounds.Height}">
                <controls:MaterialShape Kind="Arch" Width="400" Height="400"
                                        Fill="{StaticResource MdSysOnSurfaceBrush}" />
            </Border>

            <views:Shapes />

            <views:Cards />
        </StackPanel>
    </ScrollViewer>
</Window>