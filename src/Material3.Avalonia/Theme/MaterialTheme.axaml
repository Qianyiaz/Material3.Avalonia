<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Material3.Avalonia.Theme.MaterialTheme">
    <StyleInclude Source="avares://Material3.Avalonia/Styles/FocusRing.axaml" />
    <StyleInclude Source="avares://Material3.Avalonia/Styles/Typography.axaml" />
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Material3.Avalonia/Tokens/Reference/ReferenceTokens.axaml" />
                <ResourceInclude Source="avares://Material3.Avalonia/Tokens/System/SystemTokens.axaml" />
                <ResourceInclude Source="avares://Material3.Avalonia/Tokens/Component/ComponentTokens.axaml" />
                <ResourceInclude Source="avares://Material3.Avalonia/Styles/Components/ComponentThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>