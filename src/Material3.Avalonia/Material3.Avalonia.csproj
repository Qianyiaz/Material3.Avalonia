<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <NoWarn>CS1591</NoWarn>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PackageId>Material3.Avalonia</PackageId>
        <Authors>klorman</Authors>
        <Description>A modern Material Design 3 theme library for Avalonia applications</Description>
        <PackageTags>avalonia;material;ui;ux;xaml;theme</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\Fonts\**\*.ttf"/>
        <PackageReference Include="Avalonia" Version="12.1.1"/>
        <AdditionalFiles Include="Tokens\Component\Button.axaml"/>
        <ProjectReference Include="..\..\external\Bdziam.DynamicColor\src\Bdziam.DynamicColor.csproj" />
    </ItemGroup>
</Project>
