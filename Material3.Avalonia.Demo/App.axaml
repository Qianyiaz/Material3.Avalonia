<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Material3.Avalonia.Demo.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Material3.Avalonia/Tokens/Color/Reference/RefTokens.Design.axaml" />
                <ResourceInclude Source="avares://Material3.Avalonia/Tokens/Color/System/SysTokens.Design.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>